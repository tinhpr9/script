local function getRootPart()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart
    end
    return nil
end

-- Hàm bay an toàn (Tween) để không bị Anti-Cheat quét dịch chuyển tức thời
local function tweenTo(targetCFrame)
    local root = getRootPart()
    if not root then return false end
    
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local timeToTween = distance / _G.TweenSpeed
    
    if timeToTween == 0 then return true end
    
    local tweenInfo = TweenInfo.new(timeToTween, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    
    -- Tạm thời tắt va chạm (Noclip) khi bay để không bị kẹt
    local noclipConnection = game:GetService("RunService").Stepped:Connect(function()
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end)
    
    tween:Play()
    tween.Completed:Wait()
    
    noclipConnection:Disconnect()
    return true
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent then return end
    if fireproximityprompt then
        fireproximityprompt(prompt, 0, true)
    else
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    end
end

-- VÒNG LẶP AUTO FARM TOÀN DIỆN
task.spawn(function()
    print("[🥚] Khởi động vòng lặp Auto Farm (Safe Tween)...")
    
    while true do
        task.wait(0.2)
        
        if _G.AutoFarm then
            local root = getRootPart()
            if root then
                local allPrompts = {}
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        table.insert(allPrompts, obj)
                    end
                end
                
                local acted = false
                
                -- Ưu tiên 1: HATCH (Ấp trứng) hoặc PLACE (Đặt trứng) tại Base của mình
                for _, prompt in ipairs(allPrompts) do
                    local action = prompt.ActionText:lower()
                    if action:find("hatch") or action:find("place") then
                        local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            -- Bay đến mục tiêu an toàn
                            tweenTo(targetPart.CFrame * CFrame.new(0, 1.5, 0))
                            task.wait(0.2)
                            triggerPrompt(prompt)
                            print("[✨] Đã thực hiện:", action)
                            acted = true
                            break
                        end
                    end
                end
                
                -- Ưu tiên 2: STEAL (Đi ăn trộm trứng) nếu chưa có trứng trên tay
                if not acted then
                    for _, prompt in ipairs(allPrompts) do
                        local action = prompt.ActionText:lower()
                        if action:find("steal") then
                            local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                            if targetPart then
                                -- Bay đến mục tiêu an toàn
                                tweenTo(targetPart.CFrame * CFrame.new(0, 1.5, 0))
                                task.wait(0.2)
                                triggerPrompt(prompt)
                                print("[🥚] Đã nhặt trứng (Steal)!")
                                break
                            end
                        end
                    end
                end
                
            end
        end
    end
end)

