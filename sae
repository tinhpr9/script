local function getCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        return char, char.HumanoidRootPart, char.Humanoid
    end
    return nil, nil, nil
end

-- Hàm đi bộ hoàn toàn hợp lệ (Legit Walk) để tránh mọi Anti-Cheat (BAC-10511, BAC-8513)
local function walkTo(targetPosition)
    local char, root, humanoid = getCharacter()
    if not humanoid or not root then return false end
    
    -- Tăng tốc độ chạy lên mức an toàn tối đa (nếu game cho phép)
    humanoid.WalkSpeed = 25 
    
    -- Lệnh cho nhân vật đi bộ đến mục tiêu
    humanoid:MoveTo(targetPosition)
    
    -- Chờ nhân vật đi đến nơi (hoặc timeout sau 5 giây nếu bị kẹt)
    local timeout = 5
    local elapsed = 0
    while elapsed < timeout do
        local distance = (root.Position - targetPosition).Magnitude
        if distance <= 4 then -- Đã đến đủ gần để tương tác
            return true
        end
        task.wait(0.1)
        elapsed = elapsed + 0.1
        
        -- Thỉnh thoảng nhảy nếu bị kẹt
        if humanoid.MoveDirection.Magnitude > 0 and root.Velocity.Magnitude < 1 then
            humanoid.Jump = true
        end
    end
    return false
end

-- Hàm tương tác an toàn
local function safeTriggerPrompt(prompt, root)
    if not prompt or not prompt.Parent then return end
    
    -- Đảm bảo đã đứng đủ gần trước khi kích hoạt
    local distance = (root.Position - prompt.Parent.Position).Magnitude
    if distance > 10 then return end -- Xa quá không bấm, tránh bị kick
    
    if fireproximityprompt then
        fireproximityprompt(prompt, 0, true)
    else
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    end
end

