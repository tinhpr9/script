if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
repeat task.wait(0.5) until LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- Các biến toàn cục
_G.AutoFarm = true
_G.FarmSpeed = 0.5 -- Tốc độ nghỉ giữa các hành động

-- Tạo thông báo
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "🥚 SAE Auto Farm",
        Text = "Đã nạp Script! Tự động Steal ➔ Place ➔ Hatch...",
        Duration = 4,
    })
end)

local function getRootPart()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart
    end
    return nil
end

local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent then return end
    if fireproximityprompt then
        fireproximityprompt(prompt, 0, true)
    else
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    end
end

-- VÒNG LẶP AUTO FARM TOÀN DIỆN
task.spawn(function()
    print("[🥚] Khởi động vòng lặp Auto Farm (Steal -> Place -> Hatch)...")
    
    while true do
        task.wait(_G.FarmSpeed)
        
        if _G.AutoFarm then
            local root = getRootPart()
            if root then
                -- 1. Tìm tất cả các Prompt trên màn hình
                local allPrompts = {}
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        table.insert(allPrompts, obj)
                    end
                end
                
                local acted = false
                
                -- Ưu tiên 1: HATCH (Ấp trứng) hoặc PLACE (Đặt trứng) tại Base của mình
                for _, prompt in ipairs(allPrompts) do
                    local action = prompt.ActionText:lower()
                    if action:find("hatch") or action:find("place") then
                        local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                        if targetPart then
                            root.CFrame = targetPart.CFrame * CFrame.new(0, 1.5, 0)
                            task.wait(0.2)
                            triggerPrompt(prompt)
                            print("[✨] Đã thực hiện:", action)
                            acted = true
                            break
                        end
                    end
                end
                
                -- Ưu tiên 2: STEAL (Đi ăn trộm trứng) nếu chưa có trứng trên tay
                if not acted then
                    for _, prompt in ipairs(allPrompts) do
                        local action = prompt.ActionText:lower()
                        if action:find("steal") then
                            local targetPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                            if targetPart then
                                root.CFrame = targetPart.CFrame * CFrame.new(0, 1.5, 0)
                                task.wait(0.2)
                                triggerPrompt(prompt)
                                print("[🥚] Đã nhặt trứng (Steal)!")
                                break
                            end
                        end
                    end
                end
                
            end
        end
    end
end)

