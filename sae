-- 6. Hàm quét toàn bộ trứng có nút Steal trên bản đồ
local function findStealEggPrompts()
    local eggPrompts = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local action = obj.ActionText:lower()
            local object = obj.ObjectText:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            
            -- Nhận diện các nút "Steal" hoặc "Egg"
            if action:find("steal") or object:find("egg") or parentName:find("egg") then
                table.insert(eggPrompts, obj)
            end
        end
    end
    return eggPrompts
end

