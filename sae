-- 1. Chờ Game và Nhân vật nạp hoàn tất 100%
if not game:IsLoaded() then
    game.Loaded:Wait()
end
repeat task.wait(0.5) until game.Players.LocalPlayer
local LocalPlayer = game.Players.LocalPlayer
repeat task.wait(0.5) until LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
task.wait(3)

-- 2. Thiết lập FPS an toàn (>= 10 FPS theo khuyến nghị tác giả)
pcall(function()
    if setfpscap then
        setfpscap(15)
    end
end)

